@Composable
private fun SettingsRow(
    icon: @Composable () -> Unit,
    label: String,
    value: String,
    onClick: (() -> Unit)? = null,
    muted: Boolean = false
) {
    Row(
        Modifier
            .fillMaxWidth()
            .clip(RoundedCornerShape(14.dp))
            .background(
                Brush.horizontalGradient(
                    listOf(Color(0xFF23232F), Color(0xFF1A1A25))
                )
            )
            .then(if (onClick != null) Modifier.clickable(onClick = onClick) else Modifier)
            .padding(horizontal = 14.dp, vertical = 12.dp),
        verticalAlignment = Alignment.CenterVertically,
        horizontalArrangement = Arrangement.spacedBy(12.dp)
    ) {
        icon()
        Text(
            text = label,
            style = MaterialTheme.typography.titleMedium,
            color = if (muted) TextMuted else TextPrimary,
            modifier = Modifier.weight(1f),
            maxLines = 1,
            overflow = TextOverflow.Ellipsis
        )
        Text(
            text = value,
            style = MaterialTheme.typography.bodyMedium,
            color = if (muted) TextMuted else TextSecondary,
            maxLines = 1,
            overflow = TextOverflow.Ellipsis
        )
    }
}

private fun parseHex(hex: String): Color? = try {
    val h = hex.removePrefix("#")
    if (h.length == 6) Color(0xFF000000 or h.toLong(16)) else null
} catch (_: Throwable) {
    null
}


@Composable
private fun WalletPill(
    coins: Int,
    canClaimDaily: Boolean,
    coinColor: Color,
    giftColor: Color,
    isFa: Boolean,
    onClick: () -> Unit
) {
    Row(
        modifier = Modifier
            .clip(RoundedCornerShape(20.dp))
            .background(
                Brush.horizontalGradient(
                    listOf(coinColor.copy(alpha = 0.18f), coinColor.copy(alpha = 0.06f))
                )
            )
            .clickable { onClick() }
            .padding(horizontal = 12.dp, vertical = 6.dp),
        verticalAlignment = Alignment.CenterVertically,
        horizontalArrangement = Arrangement.spacedBy(6.dp)
    ) {
        Box(Modifier.size(20.dp)) {
            CoinIcon(modifier = Modifier.fillMaxSize(), tint = coinColor, animate = true)
        }
        Text(
            text = if (coins > 999)
                (if (isFa) "۹۹۹+" else "999+")
            else
                (if (isFa) toFaNum(coins) else "$coins"),
            style = MaterialTheme.typography.titleMedium,
            color = coinColor,
            fontWeight = FontWeight.SemiBold,
            maxLines = 1
        )
        if (canClaimDaily) {
            Box(
                modifier = Modifier
                    .size(20.dp)
                    .clip(RoundedCornerShape(10.dp))
                    .background(giftColor.copy(alpha = 0.28f)),
                contentAlignment = Alignment.Center
            ) {
                DailyIcon(modifier = Modifier.size(12.dp), tint = giftColor, animate = true)
            }
        }
    }
}


@Composable
private fun CoinHubActionCard(
    accent: Color,
    icon: @Composable () -> Unit,
    title: String,
    subtitle: String,
    enabled: Boolean,
    onClick: () -> Unit
) {
    val interactionSource = remember { MutableInteractionSource() }
    val pressed by interactionSource.collectIsPressedAsState()
    val scale by animateFloatAsState(
        targetValue = if (pressed) 0.97f else 1f,
        animationSpec = tween(120),
        label = "coinHubCardPress"
    )

    Row(
        modifier = Modifier
            .fillMaxWidth()
            .graphicsLayer { scaleX = scale; scaleY = scale }
            .clip(RoundedCornerShape(18.dp))
            .background(
                Brush.horizontalGradient(
                    colors = if (enabled)
                        listOf(accent.copy(alpha = 0.18f), accent.copy(alpha = 0.06f))
                    else
                        listOf(accent.copy(alpha = 0.06f), accent.copy(alpha = 0.02f))
                )
            )
            .border(
                width = 1.dp,
                brush = Brush.horizontalGradient(
                    colors = listOf(
                        accent.copy(alpha = if (enabled) 0.35f else 0.10f),
                        Color.Transparent
                    )
                ),
                shape = RoundedCornerShape(18.dp)
            )
            .clickable(
                interactionSource = interactionSource,
                indication = null,
                enabled = enabled,
                onClick = onClick
            )
            .padding(horizontal = 14.dp, vertical = 14.dp),
        verticalAlignment = Alignment.CenterVertically,
        horizontalArrangement = Arrangement.spacedBy(14.dp)
    ) {
        Box(
            Modifier
                .size(52.dp)
                .drawBehind {
                    val r = size.minDimension / 2f
                    drawCircle(
                        brush = Brush.radialGradient(
                            colors = listOf(
                                accent.copy(alpha = if (enabled) 0.35f else 0.12f),
                                Color.Transparent
                            ),
                            center = center,
                            radius = r * 1.2f
                        ),
                        radius = r * 1.2f
                    )
                }
                .clip(RoundedCornerShape(26.dp))
                .background(
                    Brush.radialGradient(
                        listOf(
                            accent.copy(alpha = if (enabled) 0.28f else 0.10f),
                            accent.copy(alpha = if (enabled) 0.10f else 0.04f)
                        )
                    )
                ),
            contentAlignment = Alignment.Center
        ) { icon() }

        Column(Modifier.weight(1f)) {
            Text(
                text = title,
                style = MaterialTheme.typography.titleMedium,
                color = if (enabled) TextPrimary else TextMuted,
                fontWeight = FontWeight.SemiBold,
                maxLines = 1
            )
            Spacer(Modifier.size(2.dp))
            Text(
                text = subtitle,
                style = MaterialTheme.typography.bodySmall,
                color = if (enabled) TextSecondary else TextMuted.copy(alpha = 0.6f),
                maxLines = 1
            )
        }

        Icon(
            Icons.AutoMirrored.Filled.KeyboardArrowRight,
            contentDescription = null,
            tint = if (enabled) accent.copy(alpha = 0.7f) else TextMuted.copy(alpha = 0.4f),
            modifier = Modifier.size(22.dp)
        )
    }
}

