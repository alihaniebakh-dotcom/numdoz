@Composable
fun YearListScreen(
    dataStore: DataStore,
    currentLang: Lang,
    onLanguageChange: (Lang) -> Unit,
    onTintChange: (Color?) -> Unit,
    onYearClick: (String) -> Unit,
    onProfileClick: () -> Unit
) {
    val audio = LocalAudio.current
    val adManager = LocalAdManager.current
    val hintColor = LocalAccent.current
    val capsuleColor = LocalAccentAlt.current
    val giftColor = LocalAccentTertiary.current
    val coinColor = Color(0xFFFFC947)
    val strings = LocalStrings.current
    val lang = LocalLang.current
    val scope = rememberCoroutineScope()

    var ready by remember { mutableStateOf(false) }
    var years by remember { mutableStateOf<List<Year>>(emptyList()) }
    var wallet by remember { mutableStateOf(UserWallet()) }
    var profile by remember { mutableStateOf(UserProfile()) }
    var loading by remember { mutableStateOf(true) }
    var error by remember { mutableStateOf<String?>(null) }
    var pendingYear by remember { mutableStateOf<Year?>(null) }

    var showHintModal by remember { mutableStateOf(false) }
    var showSettingsModal by remember { mutableStateOf(false) }
    var showTimeCapsuleModal by remember { mutableStateOf(false) }
    var showDailyModal by remember { mutableStateOf(false) }
    var showCoinModal by remember { mutableStateOf(false) }
    var adLoading by remember { mutableStateOf(false) }
    var adError by remember { mutableStateOf<String?>(null) }
    var adMessage by remember { mutableStateOf<String?>(null) }

    LaunchedEffect(Unit) {
        onTintChange(null)
        delay(60)
        ready = true
        try {
            dataStore.ensureSchema()
            dataStore.seedIfEmpty()
            years = dataStore.getAllYears()
            wallet = dataStore.getWallet()
            profile = dataStore.getProfile()
        } catch (t: Throwable) {
            error = t.message ?: t.javaClass.simpleName
        } finally { loading = false }
    }

    fun watchAdFor(kind: String) {
        adLoading = true; adError = null
        adManager.showRewarded(
            onRewarded = {
                wallet = when (kind) {
                    "coins" -> wallet.copy(coins = wallet.coins + Economy.COINS_PER_AD, totalAdsWatched = wallet.totalAdsWatched + 1)
                    "hint" -> wallet.copy(freeHints = wallet.freeHints + 1, totalAdsWatched = wallet.totalAdsWatched + 1)
                    "capsule" -> wallet.copy(freeTimeBoosts = wallet.freeTimeBoosts + 1, totalAdsWatched = wallet.totalAdsWatched + 1)
                    "daily" -> wallet.copy(coins = wallet.coins + Economy.COINS_PER_DAILY, totalAdsWatched = wallet.totalAdsWatched + 1, lastDailyRewardClaimMs = currentTimeMillis())
                    else -> wallet
                }
                scope.launch { dataStore.updateWallet(wallet) }
                adMessage = when (kind) {
                    "coins" -> strings.coinsEarned(Economy.COINS_PER_AD)
                    "hint" -> (if (lang == Lang.FA) "+Û± Ø±Ø§Ù‡Ù†Ù…Ø§" else "+1 hint")
                    "capsule" -> (if (lang == Lang.FA) "+Û± Ú©Ù¾Ø³ÙˆÙ„" else "+1 capsule")
                    "daily" -> strings.coinsEarned(Economy.COINS_PER_DAILY)
                    else -> null
                }
            },
            onClosed = { adLoading = false },
            onFailed = { msg -> adLoading = false; adError = msg }
        )
    }

    fun buyHint() {
        val price = Economy.HINT_PRICE
        if (wallet.coins < price) { adError = strings.notEnoughCoins; return }
        wallet = wallet.copy(coins = wallet.coins - price, freeHints = wallet.freeHints + 1)
        scope.launch { dataStore.updateWallet(wallet) }
        audio.playSfx(Sfx.CORRECT)
        showHintModal = false
    }

    fun buyCapsule() {
        val price = Economy.TIME_BOOST_PRICE
        if (wallet.coins < price) { adError = strings.notEnoughCoins; return }
        wallet = wallet.copy(coins = wallet.coins - price, freeTimeBoosts = wallet.freeTimeBoosts + 1)
        scope.launch { dataStore.updateWallet(wallet) }
        audio.playSfx(Sfx.CORRECT)
        showTimeCapsuleModal = false
    }

    val canClaimDaily = !isSameLocalDay(wallet.lastDailyRewardClaimMs, currentTimeMillis())

}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
// BlockingOverlay â€” eats all clicks, no ripple
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
@Composable
private fun BlockingOverlay(content: @Composable () -> Unit) {
    Box(
        Modifier
            .fillMaxSize()
            .background(Color(0xE808080E))
            .zIndex(20f)
            .clickable(
                interactionSource = remember { MutableInteractionSource() },
                indication = null,
                onClick = {}
            ),
        contentAlignment = Alignment.Center
    ) { content() }
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
// Chips / status icons
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
@Composable
private fun CoinChip(count: Int, color: Color, onClick: () -> Unit) {
    Row(
        modifier = Modifier
            .clip(RoundedCornerShape(20.dp))
            .background(
                Brush.horizontalGradient(listOf(color.copy(alpha = 0.16f), color.copy(alpha = 0.06f)))
            )
            .clickable(onClick = onClick)
            .padding(horizontal = 6.dp, vertical = 4.dp),
        verticalAlignment = Alignment.CenterVertically,
        horizontalArrangement = Arrangement.spacedBy(4.dp)
    ) {
        Box(Modifier.size(20.dp)) { CoinIcon(modifier = Modifier.fillMaxSize(), tint = color, animate = true) }
        Text(
            text = if (count > 999) (if (LocalLang.current == Lang.FA) "۹۹۹+" else "999+") else (if (LocalLang.current == Lang.FA) toFaNum(count) else "$count"),
            color = color,
            style = MaterialTheme.typography.labelLarge,
            fontWeight = FontWeight.SemiBold,
            maxLines = 1
        )
        Spacer(Modifier.size(2.dp))
    }
}

@Composable
private fun StatusIconButton(
    count: Int, tint: Color, animate: Boolean, onClick: () -> Unit,
    content: @Composable (androidx.compose.ui.unit.Dp) -> Unit
) {
    Box(Modifier.size(44.dp), contentAlignment = Alignment.Center) {
        Box(Modifier.size(40.dp).clip(CircleShape).clickable(onClick = onClick), contentAlignment = Alignment.Center) {
            content(24.dp)
        }
        if (count > 0) {
            Box(
                Modifier.align(Alignment.TopEnd).size(18.dp).clip(CircleShape)
                    .background(tint.copy(alpha = 0.95f)),
                contentAlignment = Alignment.Center
            ) {
                Text(
                    text = if (count > 9) (if (LocalLang.current == Lang.FA) "۹+" else "9+") else (if (LocalLang.current == Lang.FA) toFaNum(count) else "$count"),
                    color = Color(0xFF08080E),
                    fontSize = 9.sp, fontWeight = FontWeight.Bold, maxLines = 1
                )
            }
        }
    }
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
// ModalScaffold â€” soft fade, no border, click-blocking
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
@Composable
private fun ModalScaffold(accent: Color, content: @Composable () -> Unit) {
    Box(
        Modifier
            .fillMaxSize()
            .background(
                Brush.radialGradient(
                    colors = listOf(Color(0xE808080E), Color(0xF408080E))
                )
            )
            .zIndex(15f)
            .clickable(
                interactionSource = remember { MutableInteractionSource() },
                indication = null,
                onClick = {}
            ),
        contentAlignment = Alignment.Center
    ) {
        Column(
            Modifier
                .widthIn(max = 380.dp)
                .drawBehind {
                    // soft halo extending beyond the card
                    val r = size.maxDimension * 0.65f
                    drawCircle(
                        brush = Brush.radialGradient(
                            colors = listOf(accent.copy(alpha = 0.20f), Color.Transparent),
                            center = center, radius = r
                        ),
                        radius = r, center = center
                    )
                }
                .padding(24.dp)
                .clip(RoundedCornerShape(32.dp))
                .background(
                    Brush.verticalGradient(
                        colors = listOf(
                            accent.copy(alpha = 0.10f),
                            Color(0xFF1E1E2E).copy(alpha = 0.96f),
                            Color(0xFF14141D).copy(alpha = 0.96f)
                        )
                    )
                )
                .padding(24.dp),
            horizontalAlignment = Alignment.CenterHorizontally,
            verticalArrangement = Arrangement.spacedBy(14.dp)
        ) { content() }
    }
}

@Composable
private fun ModalActionButton(text: String, icon: @Composable (() -> Unit)?, accent: Color, primary: Boolean, onClick: () -> Unit) {
    Row(
        Modifier.fillMaxWidth().height(52.dp).clip(RoundedCornerShape(16.dp))
            .background(
                if (primary) Brush.horizontalGradient(listOf(accent.copy(alpha = 0.88f), accent.copy(alpha = 0.65f)))
                else Brush.horizontalGradient(listOf(Color(0xFF23232F), Color(0xFF1A1A25)))
            )
            .clickable(onClick = onClick)
            .padding(horizontal = 16.dp),
        verticalAlignment = Alignment.CenterVertically,
        horizontalArrangement = Arrangement.Center
    ) {
        if (icon != null) { icon(); Spacer(Modifier.size(8.dp)) }
        Text(text, style = MaterialTheme.typography.titleMedium,
            color = if (primary) Color.White else TextMuted,
            fontWeight = if (primary) FontWeight.SemiBold else FontWeight.Normal,
            maxLines = 1, overflow = TextOverflow.Ellipsis)
    }
}

@Composable
private fun SmallPill(text: String, accent: Color) {
    Box(
        Modifier.clip(RoundedCornerShape(10.dp))
            .background(Brush.horizontalGradient(listOf(accent.copy(alpha = 0.14f), accent.copy(alpha = 0.06f))))
            .padding(horizontal = 10.dp, vertical = 5.dp)
    ) {
        Text(text, style = MaterialTheme.typography.labelLarge, color = accent, maxLines = 1)
    }
}

@Composable
private fun SettingsRow(icon: @Composable () -> Unit, label: String, value: String, onClick: (() -> Unit)? = null, muted: Boolean = false) {
    Row(
        Modifier.fillMaxWidth().clip(RoundedCornerShape(14.dp))
            .background(Brush.horizontalGradient(listOf(Color(0xFF23232F), Color(0xFF1A1A25))))
            .then(if (onClick != null) Modifier.clickable(onClick = onClick) else Modifier)
            .padding(horizontal = 14.dp, vertical = 12.dp),
        verticalAlignment = Alignment.CenterVertically,
        horizontalArrangement = Arrangement.spacedBy(12.dp)
    ) {
        icon()
        Text(label, style = MaterialTheme.typography.titleMedium,
            color = if (muted) TextMuted else TextPrimary,
            modifier = Modifier.weight(1f), maxLines = 1, overflow = TextOverflow.Ellipsis)
        Text(value, style = MaterialTheme.typography.bodyMedium,
            color = if (muted) TextMuted else TextSecondary, maxLines = 1, overflow = TextOverflow.Ellipsis)
    }
}

