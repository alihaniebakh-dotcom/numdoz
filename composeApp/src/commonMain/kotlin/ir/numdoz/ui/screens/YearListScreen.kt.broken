            )
        } else {
            ModalActionButton(
                text = strings.getCoins,
                icon = { Box(Modifier.size(20.dp)) { CoinIcon(modifier = Modifier.fillMaxSize(), tint = Color.White, animate = true) } },
                accent = Color(0xFFFFC947), primary = true, onClick = onGetCoins
            )
        }
        ModalActionButton(
            text = if (isFa) "ØªÙ…Ø§Ø´Ø§ÛŒ ØªØ¨Ù„ÛŒØº â€” Ø¯Ø±ÛŒØ§ÙØª Û± Ø±Ø§ÛŒÚ¯Ø§Ù†" else "Watch ad â€” get 1 free",
            icon = { Icon(Icons.Outlined.Videocam, null, tint = accent, modifier = Modifier.size(20.dp)) },
            accent = accent, primary = false, onClick = onWatchAd
        )
        TextButton(onClick = onClose) { Text(strings.close, color = TextSecondary) }
    }
}

@Composable
private fun CapsulePurchaseModal(
    capsules: Int, coins: Int, accent: Color,
    onBuy: () -> Unit, onWatchAd: () -> Unit, onGetCoins: () -> Unit, onClose: () -> Unit
) {
    val strings = LocalStrings.current
    val isFa = LocalLang.current == Lang.FA
    val canAfford = coins >= Economy.TIME_BOOST_PRICE
    ModalScaffold(accent = accent) {
        Box(Modifier.size(76.dp).clip(RoundedCornerShape(26.dp))
            .background(Brush.radialGradient(listOf(accent.copy(alpha = 0.20f), accent.copy(alpha = 0.06f)))),
            contentAlignment = Alignment.Center
        ) { TimeBoostIcon(modifier = Modifier.size(52.dp), tint = accent, animate = true) }
        Text(strings.timeBoostLabel, style = MaterialTheme.typography.headlineMedium,
            color = TextPrimary, fontWeight = FontWeight.SemiBold, maxLines = 1)
        Row(
            Modifier.fillMaxWidth(),
            horizontalArrangement = Arrangement.spacedBy(10.dp, Alignment.CenterHorizontally),
            verticalAlignment = Alignment.CenterVertically
        ) {
            SmallPill("${if (isFa) "Ù…ÙˆØ¬ÙˆØ¯ÛŒ" else "Have"}: $capsules", accent)
            SmallPill(strings.coinCount(coins), Color(0xFFFFC947))
        }
        Text(
            if (isFa) "Ù…ÛŒâ€ŒØªÙˆÙ†ÛŒ Ø¨Ø§ Ø³Ú©Ù‡ Ø¨Ø®Ø±ÛŒ ÛŒØ§ Ø¨Ø§ ØªÙ…Ø§Ø´Ø§ÛŒ ØªØ¨Ù„ÛŒØº Ø±Ø§ÛŒÚ¯Ø§Ù† Ø¨Ú¯ÛŒØ±ÛŒ."
            else "Buy with coins or watch an ad for free.",
            style = MaterialTheme.typography.bodyMedium, color = TextSecondary,
            textAlign = TextAlign.Center, maxLines = 2
        )
        if (canAfford) {
            ModalActionButton(
                text = strings.buyWithCoins(Economy.TIME_BOOST_PRICE),
                icon = { Box(Modifier.size(20.dp)) { CoinIcon(modifier = Modifier.fillMaxSize(), tint = Color.White, animate = false) } },
                accent = accent, primary = true, onClick = onBuy
            )
        } else {
            ModalActionButton(
                text = strings.getCoins,
                icon = { Box(Modifier.size(20.dp)) { CoinIcon(modifier = Modifier.fillMaxSize(), tint = Color.White, animate = true) } },
                accent = Color(0xFFFFC947), primary = true, onClick = onGetCoins
            )
        }
        ModalActionButton(
            text = if (isFa) "ØªÙ…Ø§Ø´Ø§ÛŒ ØªØ¨Ù„ÛŒØº â€” Ø¯Ø±ÛŒØ§ÙØª Û± Ø±Ø§ÛŒÚ¯Ø§Ù†" else "Watch ad â€” get 1 free",
            icon = { Icon(Icons.Outlined.Videocam, null, tint = accent, modifier = Modifier.size(20.dp)) },
            accent = accent, primary = false, onClick = onWatchAd
        )
        TextButton(onClick = onClose) { Text(strings.close, color = TextSecondary) }
    }
}

@Composable
private fun DailyRewardModal(accent: Color, coinColor: Color, onClaim: () -> Unit, onClose: () -> Unit) {
    val strings = LocalStrings.current
    val isFa = LocalLang.current == Lang.FA
    ModalScaffold(accent = accent) {
        Box(
            Modifier.size(96.dp).clip(RoundedCornerShape(28.dp))
                .background(
                    Brush.radialGradient(listOf(accent.copy(alpha = 0.20f), accent.copy(alpha = 0.06f)))
                ),
            contentAlignment = Alignment.Center
        ) {
            DailyIcon(modifier = Modifier.size(64.dp), tint = accent, animate = true)
        }

        Text(
            text = if (isFa) "جایزه امروز" else "Today's Reward",
            style = MaterialTheme.typography.headlineMedium,
            color = TextPrimary,
            fontWeight = FontWeight.SemiBold,
            textAlign = TextAlign.Center,
            maxLines = 1
        )

        // فقط عدد سکه به‌صورت جدا + کلمه جدا
        Row(
            Modifier.clip(RoundedCornerShape(14.dp))
                .background(
                    Brush.horizontalGradient(
                        listOf(coinColor.copy(alpha = 0.16f), coinColor.copy(alpha = 0.08f))
                    )
                )
                .padding(horizontal = 16.dp, vertical = 10.dp),
            verticalAlignment = Alignment.CenterVertically,
            horizontalArrangement = Arrangement.spacedBy(8.dp)
        ) {
            Box(Modifier.size(22.dp)) {
                CoinIcon(modifier = Modifier.fillMaxSize(), tint = coinColor, animate = true)
            }
            Text(
                text = if (isFa) toFaNum(Economy.COINS_PER_DAILY) else "${Economy.COINS_PER_DAILY}",
                style = MaterialTheme.typography.titleLarge,
                color = coinColor,
                fontWeight = FontWeight.Bold,
                maxLines = 1
            )
            Text(
                text = if (isFa) "سکه" else "coins",
                style = MaterialTheme.typography.titleMedium,
                color = coinColor,
                maxLines = 1
            )
        }

        Text(
            text = if (isFa) "روزی یک بار" else "Once per day",
            style = MaterialTheme.typography.bodyMedium,
            color = TextSecondary,
            textAlign = TextAlign.Center,
            maxLines = 1
        )

        ModalActionButton(
            text = strings.claimDailyReward,
            icon = { Icon(Icons.Outlined.Videocam, null, tint = Color.White, modifier = Modifier.size(20.dp)) },
            accent = accent,
            primary = true,
            onClick = onClaim
        )

        TextButton(onClick = onClose) { Text(strings.close, color = TextSecondary) }
    }
}


@Composable
private fun HomeSettingsModal(
    currentLang: Lang, accent: Color, isMuted: Boolean,
    onToggleSound: () -> Unit, onToggleLanguage: () -> Unit, onClose: () -> Unit
) {
    val strings = LocalStrings.current
    ModalScaffold(accent = accent) {
        Box(Modifier.size(72.dp).clip(RoundedCornerShape(24.dp))
            .background(Brush.radialGradient(listOf(accent.copy(alpha = 0.18f), accent.copy(alpha = 0.05f)))),
            contentAlignment = Alignment.Center
        ) { Icon(Icons.Outlined.Settings, null, tint = accent, modifier = Modifier.size(36.dp)) }
        Text(strings.settingsTitle, style = MaterialTheme.typography.headlineMedium,
            color = TextPrimary, fontWeight = FontWeight.SemiBold, maxLines = 1)
        SettingsRow(
            icon = { Icon(Icons.Outlined.Language, null, tint = accent, modifier = Modifier.size(20.dp)) },
            label = strings.languageLabel,
            value = if (currentLang == Lang.FA) strings.languageFa else strings.languageEn,
            onClick = onToggleLanguage, muted = false
        )
        SettingsRow(
            icon = { Icon(
                imageVector = if (isMuted) Icons.AutoMirrored.Outlined.VolumeOff else Icons.AutoMirrored.Outlined.VolumeUp,
                contentDescription = null, tint = accent, modifier = Modifier.size(20.dp)) },
            label = strings.soundLabel,
            value = if (isMuted) strings.soundOff else strings.soundOn,
            onClick = onToggleSound
        )
        SettingsRow(
            icon = { Icon(Icons.Outlined.RestartAlt, null, tint = TextMuted, modifier = Modifier.size(20.dp)) },
            label = strings.resetProgressLabel, value = strings.comingSoonShort, muted = true
        )
        SettingsRow(
            icon = { Icon(Icons.Outlined.Info, null, tint = accent, modifier = Modifier.size(20.dp)) },
            label = strings.aboutLabel, value = "NumDoz v${AppInfo.VERSION_NAME}", muted = false
        )
        TextButton(onClick = onClose) { Text(strings.close, color = TextSecondary) }
    }
}

private fun parseHex(hex: String): Color? = try {
    val h = hex.removePrefix("#")
    if (h.length == 6) Color(0xFF000000 or h.toLong(16)) else null
} catch (_: Throwable) { null }
