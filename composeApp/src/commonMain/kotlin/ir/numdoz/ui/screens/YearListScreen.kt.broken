) {
    val strings = LocalStrings.current
    val isFa = LocalLang.current == Lang.FA
    val canAfford = coins >= Economy.HINT_PRICE
    ModalScaffold(accent = accent) {
        Box(Modifier.size(76.dp).clip(RoundedCornerShape(26.dp))
            .background(Brush.radialGradient(listOf(accent.copy(alpha = 0.20f), accent.copy(alpha = 0.06f)))),
            contentAlignment = Alignment.Center
        ) { HintIcon(modifier = Modifier.size(52.dp), tint = accent, animate = true) }
        Text(strings.hintLabel, style = MaterialTheme.typography.headlineMedium,
            color = TextPrimary, fontWeight = FontWeight.SemiBold, maxLines = 1)
        Row(
            Modifier.fillMaxWidth(),
            horizontalArrangement = Arrangement.spacedBy(10.dp, Alignment.CenterHorizontally),
            verticalAlignment = Alignment.CenterVertically
        ) {
            SmallPill("${if (isFa) "Ù…ÙˆØ¬ÙˆØ¯ÛŒ" else "Have"}: $hints", accent)
            SmallPill(strings.coinCount(coins), Color(0xFFFFC947))
        }
        Text(
            if (isFa) "Ù…ÛŒâ€ŒØªÙˆÙ†ÛŒ Ø¨Ø§ Ø³Ú©Ù‡ Ø¨Ø®Ø±ÛŒ ÛŒØ§ Ø¨Ø§ ØªÙ…Ø§Ø´Ø§ÛŒ ØªØ¨Ù„ÛŒØº Ø±Ø§ÛŒÚ¯Ø§Ù† Ø¨Ú¯ÛŒØ±ÛŒ."
            else "Buy with coins or watch an ad for free.",
            style = MaterialTheme.typography.bodyMedium, color = TextSecondary,
            textAlign = TextAlign.Center, maxLines = 2
        )
        if (canAfford) {
            ModalActionButton(
                text = strings.buyWithCoins(Economy.HINT_PRICE),
                icon = { Box(Modifier.size(20.dp)) { CoinIcon(modifier = Modifier.fillMaxSize(), tint = Color.White, animate = false) } },
