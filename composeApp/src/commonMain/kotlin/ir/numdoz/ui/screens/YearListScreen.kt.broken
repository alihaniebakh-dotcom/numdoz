        }
        Text(
            if (isFa) "Ø¨Ø§ Ø³Ú©Ù‡ Ù…ÛŒâ€ŒØªÙˆÙ†ÛŒ Ø±Ø§Ù‡Ù†Ù…Ø§ Ùˆ Ú©Ù¾Ø³ÙˆÙ„ Ø²Ù…Ø§Ù† Ø¨Ø®Ø±ÛŒ."
            else "Use coins to buy hints and time capsules.",
